#!/usr/bin/env sh
# Shared pre-commit hook (husky v9, installed from webos/package.json's
# "prepare" script: `cd .. && husky .husky`).
#
# It runs eslint over the WebOS sources and tests — but only when files under
# webos/src or webos/tests are actually staged, so commits that touch only
# docs or packaging stay fast. The gate matches the CI lint step
# (eslint . --max-warnings 0) so a commit that passes here passes CI.
#
# Husky runs this with `sh -e` from the repository root.
set -e

root="$(git rev-parse --show-toplevel)"
cd "$root"

staged_src="$(git diff --cached --name-only | grep -E '^webos/(src|tests)/' | tr '\n' ' ')"

if [ -z "$staged_src" ]; then
  echo "webos: no source or test changes staged — skipping eslint"
  exit 0
fi

if [ ! -f "$root/webos/node_modules/.bin/eslint" ]; then
  echo "webos: eslint is not installed — run 'npm ci' in webos/ first" >&2
  exit 1
fi

cd "$root/webos"
# Only lint the files that are actually staged — never all of src/ or tests/,
# because a staged source file would otherwise trigger eslint over every
# untracked test file in the working tree (including agent-generated ones).
# Strip the webos/ prefix since eslint runs from webos/.
staged_rel="${staged_src#webos/}"
node node_modules/.bin/eslint $staged_rel --max-warnings 0
