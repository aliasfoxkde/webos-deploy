# Cloudflare Pages header rules. The site is static except for one endpoint:
# _worker.js serves /proxy (the Browser's framing-header stripper) per
# _routes.json — every other request hits the Pages asset store directly.
# Hashed vite assets are immutable; the shell must revalidate so updates ship.
/*
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: public, max-age=0, must-revalidate
